<Window x:Class="GenshinWishTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GenshinWishTracker"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Genshin Wish Tracker"
        Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Loaded="Window_Loaded" StateChanged="Window_StateChanged">

    <!-- ================= STEP 1: THEME RESOURCES ================= -->
    <Window.Resources>
        <SolidColorBrush x:Key="GoldBrush"   Color="#E8C26A"/>
        <SolidColorBrush x:Key="MutedBrush"  Color="#8A8FA8"/>
        <SolidColorBrush x:Key="ErrorBrush"  Color="#FF7A7A"/>
        <SolidColorBrush x:Key="CardBrush"   Color="#1A1C2A"/>
        <SolidColorBrush x:Key="TrackBrush"  Color="#2A2D44"/>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="#12131C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#B8BCD0"/>
            <Setter Property="Background" Value="#1A1C2A"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2A2D44"/>
                                <Setter Property="Foreground" Value="#E8C26A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#25283A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small flat icon button (header + folder button). Uses Segoe MDL2 Assets glyphs. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#B8BCD0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2D44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stylised gold "Sync Wishes" pill button -->
        <Style x:Key="SyncButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1424"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17" Padding="22,8"
                                Background="{StaticResource GoldBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE29A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= STEP 2: PITY CARD TEMPLATE ================= -->
        <DataTemplate x:Key="BannerCardTemplate" DataType="{x:Type local:BannerStats}">
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Margin="6" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding Accent}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>

                    <!-- Big pity number -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Pity}" FontSize="58" FontWeight="Light"
                                   Foreground="{Binding PityBrush}"/>
                        <TextBlock Text="{Binding HardPity, StringFormat='/ {0}'}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="16"
                                   VerticalAlignment="Bottom" Margin="8,0,0,14"/>
                    </StackPanel>
                    <TextBlock Text="pulls since last 5★" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="2,-4,0,8"/>

                    <ProgressBar Height="8" Minimum="0"
                                 Maximum="{Binding HardPity}" Value="{Binding Pity, Mode=OneWay}"
                                 Foreground="{Binding Accent}" Background="{StaticResource TrackBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Text="{Binding StateText}" Foreground="#FFB454" FontSize="11"
                               Margin="0,6,0,0" MinHeight="16"/>

                    <!-- Mini stats row -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="4★ PITY" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding FourStarPity, StringFormat='{}{0} / 10'}"
                                       Foreground="#E6E8F2" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TOTAL PULLS" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding TotalPulls}" Foreground="#E6E8F2"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="5★ OBTAINED" Foreground="{StaticResource MutedBrush}" FontSize="9.5"/>
                            <TextBlock Text="{Binding FiveStarCount}" Foreground="#E6E8F2"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="LAST 5★" Foreground="{StaticResource MutedBrush}"
                               FontSize="9.5" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding LastFiveStar}" Foreground="{StaticResource GoldBrush}"
                               FontSize="13" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ================= STEP 3: WINDOW LAYOUT ================= -->
    <Border x:Name="WindowFrame" CornerRadius="16" Background="#12131C"
            BorderBrush="#2A2D44" BorderThickness="1">
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="✦" Foreground="{StaticResource GoldBrush}" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="GENSHIN COMPANION" Foreground="#E6E8F2" FontSize="13"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UidText" Text="UID —" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" Margin="14,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="Keep on top" Click="PinButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaximizeButton_Click"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,8,0,0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabItem x:Name="DashboardTab" Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="Genshin Companion" FontSize="26" FontWeight="SemiBold"
                                       Foreground="#E6E8F2"/>
                            <TextBlock Text="Your game tools, together in one place."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,20"/>
                            <UniformGrid Columns="2">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="6" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="WISH TRACKER" Foreground="{StaticResource GoldBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="DashboardWishSummary" Text="No wish history loaded"
                                                   Foreground="#E6E8F2" Margin="0,8,0,12"/>
                                        <Button Content="Open Wish Tracker" HorizontalAlignment="Left"
                                                Padding="12,6" Click="OpenWishTracker_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="6" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="RESIN &amp; DAILY" Foreground="{StaticResource GoldBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Resin, commissions, and Realm Currency."
                                                   Foreground="#E6E8F2" Margin="0,8,0,12"/>
                                        <Button Content="Open Resin Dashboard" HorizontalAlignment="Left"
                                                Padding="12,6" Click="OpenResin_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="6" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="BUILD EVALUATOR" Foreground="{StaticResource GoldBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Review showcase characters and artifact stats."
                                                   Foreground="#E6E8F2" Margin="0,8,0,12"/>
                                        <Button Content="Open Build Evaluator" HorizontalAlignment="Left"
                                                Padding="12,6" Click="OpenBuilds_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                        Margin="6" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="PRIMOGEM PLANNER" Foreground="{StaticResource GoldBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Estimate your featured 5★ chance from your savings."
                                                   Foreground="#E6E8F2" Margin="0,8,0,12"/>
                                        <Button Content="Open Primogem Planner" HorizontalAlignment="Left"
                                                Padding="12,6" Click="OpenPlanner_Click"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="WishTrackerTab" Header="Wishes">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl x:Name="CardsHost" Grid.Row="0" Margin="0,0,0,0"
                                      ItemTemplate="{StaticResource BannerCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Grid Grid.Row="1" Margin="6,6,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StatusText" Text="Ready." Foreground="{StaticResource MutedBrush}"
                                       FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="FolderButton" Style="{StaticResource IconButton}" Content="&#xE838;"
                                        ToolTip="Set game folder manually" Click="FolderButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="SyncButton" Style="{StaticResource SyncButton}" Click="SyncButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,1,8,0"/>
                                        <TextBlock Text="Sync Wishes"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ResinTab" Header="Resin &amp; Daily">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Resin &amp; Daily Dashboard" FontSize="24"
                                       FontWeight="SemiBold" Foreground="#E6E8F2"/>
                            <TextBlock Text="Sign in to HoYoLAB to load your Genshin real-time notes."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="4,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HoyolabSignInButton" Grid.Column="0" Content="Sign in to HoYoLAB"
                                    Padding="14,7" Click="HoyolabSignInButton_Click"/>
                            <ComboBox x:Name="HoyolabRoleSelector" Grid.Column="1" Margin="10,0"
                                      VerticalContentAlignment="Center" MinWidth="180"
                                      SelectionChanged="HoyolabRoleSelector_SelectionChanged"
                                      ToolTip="Select your Genshin account"/>
                            <Button x:Name="HoyolabLoadAccountsButton" Grid.Column="2"
                                    Content="Load accounts" Padding="14,7" Margin="0,0,8,0"
                                    Click="HoyolabLoadAccountsButton_Click"/>
                            <Button x:Name="HoyolabRefreshButton" Grid.Column="3"
                                    Content="Refresh notes" Padding="14,7"
                                    Click="HoyolabRefreshButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="HoyolabStatusText" Grid.Row="2" Text="Sign in with the HoYoLAB page below, then choose Load accounts."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="4,0,4,10"/>
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2">
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="ORIGINAL RESIN" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="ResinAmountText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="ResinRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="DAILY COMMISSIONS" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="CommissionsText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="CommissionRewardText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="REALM CURRENCY" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="RealmCurrencyText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="RealmCurrencyRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="EXPEDITIONS" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10"/>
                                            <TextBlock x:Name="ExpeditionsText" Text="— / —" Foreground="#E6E8F2"
                                                       FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="ExpeditionsRecoveryText" Text="Sign in to load"
                                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <TextBlock Grid.Row="1" Text="Data is requested from HoYoLAB only when you choose to refresh. Login cookies remain in the encrypted WebView2 profile and are used transiently for the API request."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           FontSize="11" Margin="8,4"/>
                            </Grid>
                            <Border Grid.Column="1" Margin="4" CornerRadius="10"
                                    BorderBrush="#2A2D44" BorderThickness="1">
                                <Grid>
                                    <wv2:WebView2 x:Name="HoyolabAuthView" Visibility="Collapsed"/>
                                    <TextBlock x:Name="HoyolabAuthPlaceholder"
                                               Text="HoYoLAB sign-in opens here after you click “Sign in to HoYoLAB”."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="24"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="InteractiveMapTab" Header="Interactive Map">
                    <Grid Background="#12131C">
                        <wv2:WebView2 x:Name="InteractiveMap"/>
                        <Border x:Name="MapStatusPanel" Background="#E612131C" Padding="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                CornerRadius="10" MaxWidth="560">
                            <StackPanel>
                                <TextBlock x:Name="MapStatusText" Text="The map will load when you open this tab."
                                           Foreground="#E6E8F2" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <Button x:Name="MapOpenBrowserButton" Content="Open map in browser"
                                        HorizontalAlignment="Center" Padding="12,6" Visibility="Collapsed"
                                        Click="MapOpenBrowserButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="BuildEvaluatorTab" Header="Builds">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="4,0,4,14">
                            <TextBlock Text="Artifact &amp; Character Builds" FontSize="24"
                                       FontWeight="SemiBold" Foreground="#E6E8F2"/>
                            <TextBlock Text="Look up your public in-game character showcase and review artifact stats."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="4,0,4,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BuildUidInput" Grid.Column="0" MaxLength="9"
                                     VerticalContentAlignment="Center" Padding="10,8"
                                     FontSize="14" Background="{StaticResource CardBrush}"
                                     Foreground="#E6E8F2" BorderBrush="#2A2D44"
                                     ToolTip="Enter your 9-digit public Genshin UID"
                                     KeyDown="BuildUidInput_KeyDown"/>
                            <Button x:Name="BuildLookupButton" Grid.Column="1" Content="Load Showcase"
                                    Padding="14,7" Margin="8,0,0,0" Click="BuildLookupButton_Click"/>
                            <Button Grid.Column="2" Content="Use saved UID" Padding="14,7"
                                    Margin="8,0,0,0" Click="UseSavedUid_Click"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <wv2:WebView2 x:Name="BuildWebView"/>
                            <Border x:Name="BuildStatusPanel" Background="#E612131C" Padding="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    CornerRadius="10" MaxWidth="560">
                                <StackPanel>
                                    <TextBlock x:Name="BuildStatusText"
                                               Text="Enter a 9-digit UID to view its public Enka.Network character showcase."
                                               Foreground="#E6E8F2" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,0,0,12"/>
                                    <Button x:Name="BuildOpenBrowserButton" Content="Open showcase in browser"
                                            HorizontalAlignment="Center" Padding="12,6"
                                            Visibility="Collapsed" Click="BuildOpenBrowserButton_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="PrimogemPlannerTab" Header="Primogem Planner">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="4,0,4,16">
                                <TextBlock Text="Primogem Planner" FontSize="24" FontWeight="SemiBold"
                                           Foreground="#E6E8F2"/>
                                <TextBlock Text="Estimate the chance to obtain your target featured 5★ with your current savings."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="AVAILABLE WISHES" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerAvailableWishes" Text="0" Foreground="#E6E8F2"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="FEATURED 5★ CHANCE" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerChance" Text="0%" Foreground="#59D98E"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Margin="5" Padding="15">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="WISHES TO GUARANTEE" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="PlannerGuaranteePulls" Text="—" Foreground="#E6E8F2"
                                                   FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Margin="5" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="6,4,16,4">
                                        <TextBlock Text="Primogem stash" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PlannerPrimogemsValue" Text="0 Primogems"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerPrimogemsSlider" Minimum="0" Maximum="32000"
                                                Value="0" TickFrequency="160" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                        <TextBlock Text="Intertwined Fates" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="PlannerFatesValue" Text="0 Fates"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerFatesSlider" Minimum="0" Maximum="200"
                                                Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,4,6,4">
                                        <TextBlock Text="Current pity" Foreground="#E6E8F2"
                                                   FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="PlannerPityValue" Text="0 / 90"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                        <Slider x:Name="PlannerPitySlider" Minimum="0" Maximum="89"
                                                Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="PlannerInput_ValueChanged"/>
                                        <CheckBox x:Name="PlannerGuaranteedCheckBox"
                                                  Content="Featured 5★ is guaranteed"
                                                  Foreground="#E6E8F2" Margin="0,20,0,0"
                                                  Checked="PlannerInput_Changed"
                                                  Unchecked="PlannerInput_Changed"/>
                                        <TextBlock Text="Probability uses an estimated character-event pity curve; actual game results are random."
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                   Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ProgressBar x:Name="PlannerChanceBar" Grid.Row="3" Minimum="0" Maximum="100"
                                         Height="10" Margin="6,10,6,4" Foreground="#3978FF"
                                         Background="{StaticResource TrackBrush}" BorderThickness="0"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
